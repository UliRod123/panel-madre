# Postgres del PANEL MADRE (nuevo y aparte: aquí solo viven las cuentas con PIN).
DATABASE_URL="postgresql://usuario:clave@host:5432/base?sslmode=require"
# Conexión directa para migrar, si DATABASE_URL pasa por un pooler.
DIRECT_DATABASE_URL=""
# Firma de la cookie de sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
ZONA_HORARIA="America/Mexico_City"
# Opcional: si se pone, el primer arranque la pide para crear la cuenta del dueño.
CLAVE_INSTALACION=""

# ── Los tres paneles ────────────────────────────────────────────
# Cada clave debe ser IGUAL a la RESUMEN_SECRETO de ese panel.
# Genera una distinta para cada uno con: openssl rand -base64 32
RESUMEN_SECRETO_PRODUCCION=""
RESUMEN_SECRETO_RASTREO=""
RESUMEN_SECRETO_PEDIDOS=""

# Direcciones. Solo cámbialas si un panel cambia de dominio.
PRODUCCION_URL="https://controldeproduccion.vercel.app"
RASTREO_URL="https://panel-de-rastreo.vercel.app"
PEDIDOS_URL="https://franjalc-pedidos.vercel.app"
# La función de Supabase que da el resumen de Pedidos.
PEDIDOS_RESUMEN_URL="https://oarszkbfohniewmejjbn.supabase.co/functions/v1/resumen-madre"
